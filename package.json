{
  "name": "playlist-synchronizer",
  "version": "2.0.0",
  "description": "The app allows to sync playlists between music services",
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "format": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "check-types": "tsc --noemit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "prepare": "husky || true"
  },
  "keywords": [
    "yandex",
    "yandex-music",
    "spotify",
    "synchronizer"
  ],
  "author": "Pavel Karpovich <pavel.karpovich@outlook.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/signale": "^1.4.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fetch-socks": "^1.3.3",
    "helmet": "^8.3.0",
    "signale": "^1.4.0",
    "yup": "^1.7"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:pkarpovich/playlist-synchronizer.git"
  },
  "pnpm": {
    "overrides": {
      "qs@<6.14.2": ">=6.14.2",
      "picomatch@<2.3.2": ">=2.3.2",
      "undici": "^7.0.0"
    }
  }
}
